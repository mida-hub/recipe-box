# ステージ1: ビルダー (esbuild による単一バンドル化)
FROM node:24-alpine AS builder

WORKDIR /usr/src/app

COPY ./backend/package*.json ./

# 本番依存関係のみクリーンインストール
RUN npm ci --omit=dev --ignore-scripts

# バックエンドのソースコードをコピー
COPY ./backend .

# バンドラーとして独立して動作する esbuild を一時インストールして単一ファイル化
RUN npx --yes esbuild index.js --bundle --platform=node --target=node24 --minify --outfile=dist/index.bundle.js

# ステージ2: プロダクション実行環境 (最小構成)
FROM node:24-alpine AS production

WORKDIR /usr/src/app

ENV NODE_ENV=production

# バンドルされた単一JSファイルのみをコピー (node_modules は不要)
COPY --from=builder /usr/src/app/dist/index.bundle.js ./index.js

EXPOSE 3000

# 単一ファイルを起動
CMD ["node", "index.js"]
